---
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import Gallery from "../components/Gallery.astro";
import About from "../components/About.astro";
import WorkProcess from "../components/WorkProcess.astro";
import Coverage from "../components/Coverage.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
---

<html lang="es-CO">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/fav-icon.png" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Trabajos de construcción, electricidad, mantenimiento, obra negra y obra blanca con atención directa y responsable."
		/>
		<title>
			Juan Quindío Construcciones | Construcción, electricidad y
			mantenimiento
		</title>
	</head>
	<body>
		<Header />
		<main>
			<Hero />
			<Services />
			<Gallery />
			<About />
			<Contact />
		</main>
		<Footer />
	</body>
</html>
