---
import { workProcessSteps } from "../data/process";
---

<section
    id="como-trabajo"
    aria-labelledby="process-title"
    class="bg-white py-16 text-[#17212b] sm:py-20"
>
    <div
        class="mx-auto w-[calc(100%_-_3rem)] max-w-[1180px] lg:w-[calc(100%_-_4rem)]"
    >
        <div class="text-center max-w-2xl mx-auto">
            <p class="text-sm font-extrabold uppercase text-[#c68102]">
                Cómo trabajo
            </p>
            <h2
                id="process-title"
                class="mt-3 break-words text-2xl font-extrabold leading-tight sm:text-4xl"
            >
                Un proceso directo y responsable
            </h2>
            <p
                class="mt-4 break-words text-base leading-7 text-[#546170] sm:text-lg"
            >
                Garantizo orden y confiabilidad en cada paso del proyecto.
            </p>
        </div>

        <div class="mt-12 relative">
            <div
                class="hidden lg:block absolute top-[28px] left-[calc(10%_-_1px)] right-[calc(10%_-_1px)] h-[2px] bg-[#e8ece8]"
                aria-hidden="true"
            >
            </div>

            <ol class="grid grid-cols-1 gap-8 lg:grid-cols-5 text-center">
                {
                    workProcessSteps.map((step) => (
                        <li class="relative">
                            <div class="flex flex-col items-center">
                                <div class="relative z-10 flex h-14 w-14 items-center justify-center rounded-full border-4 border-white bg-[#0c3d8f] text-lg font-extrabold text-white shadow-[0_8px_20px_rgba(7,28,63,0.12)]">
                                    {step.id}
                                </div>
                                <h3 class="mt-5 text-lg font-extrabold leading-tight">
                                    {step.title}
                                </h3>
                                <p class="mt-3 text-sm leading-6 text-[#546170] max-w-[250px]">
                                    {step.description}
                                </p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>
    </div>
</section>
