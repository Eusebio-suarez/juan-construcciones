---
import { galleryCategories, galleryItems } from "../data/gallery";
import { whatsappUrl } from "../data/site";
---

<section
  id="trabajos"
  aria-labelledby="gallery-title"
  class="bg-white py-16 text-[#17212b] sm:py-20"
>
  <div
    class="mx-auto w-[calc(100%_-_3rem)] max-w-[1180px] lg:w-[calc(100%_-_4rem)]"
  >
    <div
      class="grid gap-8 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:items-end"
    >
      <div class="min-w-0">
        <p class="text-sm font-extrabold uppercase text-[#c68102]">
          Trabajos realizados
        </p>
        <h2
          id="gallery-title"
          class="mt-3 max-w-2xl break-words text-2xl font-extrabold leading-tight sm:text-4xl"
        >
          Galería de trabajos
        </h2>
      </div>

      <ul
        class="flex min-w-0 flex-wrap gap-2 lg:justify-end"
        aria-label="Categorías de trabajos"
      >
        {
          galleryCategories.map((category) => (
            <li class="rounded-full border border-[#17212b]/10 bg-[#f5f7f2] px-3 py-2 text-sm font-extrabold text-[#546170]">
              {category}
            </li>
          ))
        }
      </ul>
    </div>

    <div
      class="mt-10 columns-1 gap-6 sm:columns-2 lg:columns-3 [&>article]:mb-6"
    >
      {
        galleryItems.map((item) => (
          <article class="group inline-block w-full overflow-hidden rounded-lg border border-[#17212b]/10 bg-[#f7f8f5] shadow-[0_14px_36px_rgba(7,28,63,0.08)] transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_44px_rgba(7,28,63,0.12)] break-inside-avoid">
            <div class="relative overflow-hidden border-b border-[#17212b]/10 bg-[#e8ece8]">
              {item.type === "video" ? (
                <video
                  src={`/${item.src}`}
                  class="block h-auto w-full transition duration-300 group-hover:scale-105"
                  autoplay
                  loop
                  muted
                  playsinline
                />
              ) : (
                <img
                  src={`/${item.src}`}
                  alt={item.title}
                  class="block h-auto w-full transition duration-300 group-hover:scale-105"
                  loading="lazy"
                />
              )}
            </div>

            <div class="p-5">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-[#f3b51f]/25 px-3 py-1 text-xs font-extrabold uppercase text-[#7a5103]">
                  {item.category}
                </span>
              </div>

              <h3 class="mt-4 break-words text-xl font-extrabold leading-snug">
                {item.title}
              </h3>

              {item.description && (
                <p class="mt-3 text-sm leading-relaxed text-[#546170]">
                  {item.description}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-12 flex justify-center !text-white">
      <a
                href={whatsappUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 rounded-lg bg-[#25d366] px-8 py-4 text-center text-lg font-extrabold text-white transition duration-200 hover:bg-[#1da851] hover:scale-105 active:scale-95 shadow-[0_14px_36px_rgba(37,211,102,0.3)]"
            >
                <svg
                    class="h-6 w-6"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                >
                    <path
                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"
                    ></path>
                </svg>
                Obtener mas informacion
            </a>
    </div>
  </div>
</section>
