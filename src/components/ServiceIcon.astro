---
interface Props {
  name: string;
}

const { name } = Astro.props;

const icons = {
  construction:
    '<path d="M7 20h10" /><path d="M9 20v-7l3-3 3 3v7" /><path d="M8 9l4-4 4 4" /><path d="M4 20h16" />',
  finishes:
    '<path d="M7 4h7a3 3 0 0 1 0 6H7z" /><path d="M7 10v10" /><path d="M11 10v10" /><path d="M15 14h3a2 2 0 0 1 0 4h-3" />',
  electricity:
    '<path d="M13 2 5 14h6l-1 8 8-12h-6z" />',
  maintenance:
    '<path d="m14.7 6.3 3 3" /><path d="M17.7 3.3a2.1 2.1 0 0 1 3 3L8 19l-4 1 1-4z" />',
  remodeling:
    '<path d="M4 20V8l8-4 8 4v12" /><path d="M9 20v-7h6v7" /><path d="M4 11h16" />',
};

const icon = icons[name as keyof typeof icons] ?? icons.construction;
---

<svg
  class="h-6 w-6"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <Fragment set:html={icon} />
</svg>
