---
import { aboutInfo } from "../data/about";
import { siteInfo } from "../data/site";
---

<section
    id="sobre-mi"
    aria-labelledby="about-title"
    class="bg-[#f7f8f5] py-16 text-[#17212b] sm:py-20"
>
    <div
        class="mx-auto w-[calc(100%_-_3rem)] max-w-[1180px] lg:w-[calc(100%_-_4rem)]"
    >
        <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
            <div
                class="relative aspect-square w-full max-w-md mx-auto lg:mx-0 overflow-hidden rounded-2xl border border-[#17212b]/10 bg-[#e8ece8] shadow-[0_14px_36px_rgba(7,28,63,0.08)]"
            >
                {
                    aboutInfo.image ? (
                        <img
                            src={`/${aboutInfo.image}`}
                            alt={`Foto de ${siteInfo.shortName}`}
                            class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 hover:scale-105"
                            loading="lazy"
                        />
                    ) : (
                        <>
                            <div
                                class="absolute inset-0 opacity-70"
                                aria-hidden="true"
                                style="background-image: linear-gradient(135deg, rgba(12,61,143,0.12) 25%, transparent 25%, transparent 50%, rgba(12,61,143,0.12) 50%, rgba(12,61,143,0.12) 75%, transparent 75%, transparent); background-size: 28px 28px;"
                            ></div>
                            <div class="absolute inset-0 grid place-items-center text-center p-6">
                                <svg
                                    class="h-16 w-16 text-[#546170] mb-4"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    aria-hidden="true"
                                >
                                    <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2" />
                                    <circle cx="12" cy="7" r="4" />
                                </svg>
                                <span class="rounded-full bg-white px-4 py-2 text-sm font-extrabold text-[#17212b] shadow-[0_8px_20px_rgba(7,28,63,0.12)]">
                                    Foto pendiente
                                </span>
                            </div>
                        </>
                    )
                }
            </div>

            <div class="min-w-0">
                <p class="text-sm font-extrabold uppercase text-[#c68102]">
                    {aboutInfo.title}
                </p>
                <h2
                    id="about-title"
                    class="mt-3 max-w-2xl break-words text-2xl font-extrabold leading-tight sm:text-4xl"
                >
                    {siteInfo.shortName}
                </h2>
                <div
                    class="mt-6 space-y-6 text-base leading-7 text-[#546170] sm:text-lg"
                >
                    <p>
                        {aboutInfo.description}
                    </p>
                </div>

                <ul class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <li
                        class="flex items-center gap-3 rounded-lg border border-[#17212b]/10 bg-white p-4 shadow-[0_4px_12px_rgba(7,28,63,0.04)]"
                    >
                        <svg
                            class="h-6 w-6 text-[#0c3d8f]"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                            ></path></svg
                        >
                        <div>
                            <span
                                class="block text-xs font-bold uppercase text-[#546170]"
                                >Experiencia</span
                            >
                            <span
                                class="block text-sm font-extrabold text-[#17212b]"
                                >{aboutInfo.experienceYears}</span
                            >
                        </div>
                    </li>
                    <li
                        class="flex items-center gap-3 rounded-lg border border-[#17212b]/10 bg-white p-4 shadow-[0_4px_12px_rgba(7,28,63,0.04)]"
                    >
                        <svg
                            class="h-6 w-6 text-[#0c3d8f]"
                            xmlns="http://www.w3.org/2000/svg"
                            width="24"
                            height="24"
                            viewBox="0 0 24 24"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="2"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path
                                d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"
                            ></path><circle cx="12" cy="10" r="3"></circle></svg
                        >
                        <div>
                            <span
                                class="block text-xs font-bold uppercase text-[#546170]"
                                >Cobertura</span
                            >
                            <span
                                class="block text-sm font-extrabold text-[#17212b]"
                                >{aboutInfo.coverageArea}</span
                            >
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>
